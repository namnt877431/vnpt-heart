# SITE_ADDRESS (deploy/.env):
#   :80                   plain HTTP on the server's IP (demo, internal network)
#   game.example.vn       a domain pointing at this server -> automatic HTTPS (Let's Encrypt)
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle_path /uploads/* {
		root * /srv-uploads
		file_server
	}

	handle {
		root * /srv
		# build output with a content hash in the name (app code, CSS, fonts): cache forever
		@hashed path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# everything else (index.html, admin.html, images that keep their name): revalidate
		# with the server each time (cheap 304 via ETag), so new versions/themes show up at once
		@plain not path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$
		header @plain Cache-Control "no-cache"
		file_server
	}
}
