# Copy to deploy/.env on the server and fill in. NEVER commit deploy/.env.

# Database password (any long random string), e.g.: openssl rand -base64 24
POSTGRES_PASSWORD=

# :80 = HTTP on the server IP. A domain (game.example.vn) = automatic HTTPS.
SITE_ADDRESS=:80
# true once the site is on HTTPS (domain set above)
COOKIE_SECURE=false

# Login: "dev" = test accounts (password vnpt@123) for the demo only.
# Switch to "ldap" when IT provides the LDAP/AD details below.
AUTH_PROVIDER=dev
LDAP_URL=ldaps://ldap.example.vnpt.vn:636
LDAP_BASE_DN=dc=vnpt,dc=vn
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_ATTR=sAMAccountName
LDAP_TLS_VERIFY=true

# Comma-separated usernames that become admin when they log in.
ADMIN_USERNAMES=admin

SESSION_DAYS=30
