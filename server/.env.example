# Copy to .env (never commit .env).

PORT=3000
# PostgreSQL: postgres://user:pass@host:5432/vnpt_heart
# Local dev without PostgreSQL: pglite://./.data/pglite (embedded, stored in that folder)
DATABASE_URL=pglite://./.data/pglite

# dev  = test accounts from the seed (password "vnpt@123"), NEVER in production
# ldap = company LDAP / Active Directory
AUTH_PROVIDER=dev
LDAP_URL=ldaps://ldap.example.vnpt.vn:636
LDAP_BASE_DN=dc=vnpt,dc=vn
LDAP_BIND_DN=cn=svc-vnptheart,ou=service,dc=vnpt,dc=vn
LDAP_BIND_PASSWORD=
# attribute users type as their login: sAMAccountName (AD), uid, or mail
LDAP_USER_ATTR=sAMAccountName
# set false only for a test LDAP with a self-signed certificate
LDAP_TLS_VERIFY=true

# comma-separated usernames that become admin on login
ADMIN_USERNAMES=admin

UPLOAD_DIR=./.data/uploads
# true when the site is served over HTTPS
COOKIE_SECURE=false
SESSION_DAYS=30

# Optional: serve the built client (client/dist) from Node too, e.g. on Windows
# Server without Caddy/IIS static hosting. Leave empty when Caddy serves it.
CLIENT_DIST=
